# Database (matches docker-compose.yml — host port 5433 to avoid clashing with other local stacks on 5432)
DB_URL=jdbc:postgresql://localhost:5433/reflectly
DB_USERNAME=test_user
DB_PASSWORD=test_password

# Optional: use 8081 if another app already binds 8080
# SERVER_PORT=8081

# Backend JWT signing key (minimum 32 characters)
JWT_SECRET=change-me-to-a-secure-secret-at-least-32-chars

# Google OAuth (Web application client — same ID used by frontend)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional: comma-separated allowed frontend origins for CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Optional: use prod profile locally only when testing production settings
# SPRING_PROFILES_ACTIVE=local

# Google Gemini API key (Coach Agent + Memory Extraction) — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here

# AES-256 key for encrypting conversation message content at rest (32 bytes, base64-encoded)
ENCRYPTION_KEY=

# Whether raw conversation message content is purged after memory extraction succeeds (default false —
# transcripts are kept, encrypted at rest, so users can revisit past chat history)
# PURGE_TRANSCRIPTS=false
